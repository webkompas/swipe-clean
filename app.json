{
  "expo": {
    "name": "Swipe Clean",
    "slug": "swipe-clean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.swipeclean.app"
    },
    "plugins": [
      "expo-image",
      "expo-video",
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "Swipe Clean toont je foto's en video's één voor één, zodat je kunt kiezen wat je bewaart en wat je wist.",
          "savePhotosPermission": "Swipe Clean heeft toegang nodig om foto's te kunnen verwijderen.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Swipe Clean gebruikt je locatie om bij een foto de plaatsnaam te tonen."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "57e6b4e3-2881-4695-8fbe-f3bdbd7a0cf3"
      }
    },
    "owner": "sandervdhs-team",
    "updates": {
      "url": "https://u.expo.dev/57e6b4e3-2881-4695-8fbe-f3bdbd7a0cf3"
    },
    "runtimeVersion": "exposdk:58.0.0"
  }
}
